{
  "name": "file-input",
  "version": "0.0.0",
  "scripts": {
    "build:docs": "ng build file-input --configuration production --base-href /file-input-accessor/",
    "build:lib": "ng build file-input-accessor --configuration production",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "npm run test:lib && npm run test:app",
    "test:lib": "ng test file-input-accessor --watch false",
    "test:app": "npm run build:lib && ng test file-input --watch false",
    "lint": "ng lint"
  },
  "private": true,
  "workspaces": [
    "projects/file-input-accessor"
  ],
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "core-js": "2.6.3",
    "file-input-accessor": "22.0.0",
    "rxjs": "^7.4.0",
    "tslib": "^2.2.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.19.41",
    "@vitest/browser-playwright": "^4.1.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.3.0",
    "ng-packagr": "^22.2.5",
    "playwright": "^1.60.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.1.6"
  }
}
